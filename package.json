{
  "name": "modernized-classics",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run fix-markdown && astro dev",
    "fix-markdown": "tsx scripts/fix-markdown.ts",
    "format:books": "tsx scripts/fix-markdown.ts",
    "build": "tsx scripts/generate-epubs.ts && astro build",
    "generate-epubs": "tsx scripts/generate-epubs.ts",
    "postbuild": "tsx scripts/check-epubs.ts",
    "preview": "astro preview",
    "astro": "astro",
    "clear-cache": "node -e \"const fs=require('fs'); if(fs.existsSync('node_modules/.astro')) fs.rmSync('node_modules/.astro', {recursive:true})\"",
    "test": "vitest run --passWithNoTests",
    "modernize": "tsx pipeline/src/cli.ts",
    "typecheck": "tsc --noEmit -p pipeline/tsconfig.json",
    "verify": "npm run check:repository && npm run typecheck && npm test && npx astro check && npm run verify:build",
    "check:repository": "node scripts/check-repository.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "smoke:model": "tsx scripts/smoke-model.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-accordion": "^1.2.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "adm-zip": "^0.6.0",
    "astro": "^7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.501.0",
    "node-html-parser": "^7.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@tailwindcss/typography": "^0.5.16",
    "@types/adm-zip": "^0.5.7",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.4.21",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.7.0",
    "unified": "^11.0.5",
    "vfile-reporter": "^8.1.1",
    "vitest": "^5.0.0"
  },
  "private": true,
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@11.17.0"
}
