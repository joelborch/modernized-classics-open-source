---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-row">
    <div class="footer-col">
      <p class="t-text footer-mark">Modernized Classics</p>
      <p class="t-meta footer-note">
        Public-domain works rewritten into clear modern English, free to read, download, and share.
        The texts are machine-rewritten and checked against their sources; read the
        <a href="/about/">colophon</a> before you quote one.
      </p>
    </div>
    <nav class="footer-col footer-links" aria-label="Footer">
      <a href="/library/">Library</a>
      <a href="/about/">Colophon</a>
      <a href="/about/#contribute">Contribute</a>
      <a href="https://github.com/joelborch/modernized-classics-open-source" rel="noopener">Source on GitHub</a>
    </nav>
    <nav class="footer-col footer-links" aria-label="Legal">
      <a href="/terms-of-service/">Terms</a>
      <a href="/privacy-policy/">Privacy</a>
    </nav>
  </div>
  <div class="wrap footer-base t-meta">
    <span>© {year} Modernized Classics. Site and pipeline MIT-licensed; the editions are free to read and share.</span>
    <a href="#main" class="footer-top link-quiet">Back to top
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 16V4m0 0L5 9m5-5l5 5" /></svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--rule);
    margin-top: 5rem;
    padding: 2.5rem 0 2rem;
    color: var(--ink-8);
    font-family: var(--font-ui);
  }
  .footer-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .footer-row { grid-template-columns: 2fr 1fr 1fr; gap: 3rem; }
  }
  .footer-mark { font-size: 1.125rem; font-weight: 500; color: var(--ink-10); margin: 0 0 0.5rem; }
  .footer-note { max-width: 44ch; line-height: 1.55; margin: 0; }
  .footer-links { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9375rem; }
  .footer-links a { text-decoration: none; color: var(--ink-8); }
  .footer-links a:hover { color: var(--ink-10); text-decoration: underline; }
  .footer-base {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: var(--rule);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-top { color: var(--ink-7); display: inline-flex; align-items: center; gap: 0.35rem; }
  .footer-top svg { width: 0.875rem; height: 0.875rem; }
</style>
