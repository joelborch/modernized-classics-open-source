---
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header-row">
    <a href="/" class="wordmark t-text" aria-label="Modernized Classics, home">
      <span class="wordmark-main">Modernized Classics</span>
      <span class="wordmark-sub t-label">Public-domain works, in the English you already speak</span>
    </a>

    <nav class="site-nav" aria-label="Site">
      <a href="/library/" aria-current={isCurrent('/library') ? 'page' : undefined}>Library</a>
      <a href="/about/" aria-current={isCurrent('/about') ? 'page' : undefined}>Colophon</a>
      <a href="https://github.com/joelborch/modernized-classics-open-source" rel="noopener" class="site-nav-ext">Source</a>
    </nav>

    <button type="button" class="theme-cycle" id="theme-cycle" aria-label="Switch theme" title="Switch theme: light, sepia, dark">
      <span class="swatch" id="theme-cycle-swatch"></span>
    </button>
    <div class="theme-set" role="group" aria-label="Theme">
      <button type="button" class="theme-swatch" data-set-theme="light" aria-label="Light" title="Light">
        <span class="swatch swatch-light"></span>
      </button>
      <button type="button" class="theme-swatch" data-set-theme="sepia" aria-label="Sepia" title="Sepia">
        <span class="swatch swatch-sepia"></span>
      </button>
      <button type="button" class="theme-swatch" data-set-theme="dark" aria-label="Dark" title="Dark">
        <span class="swatch swatch-dark"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: var(--rule);
    background: var(--paper);
  }
  .site-header-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--site-header-h);
  }
  @media (min-width: 640px) { .site-header-row { gap: 1.25rem; } }
  .wordmark {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-decoration: none;
    line-height: 1;
    padding: 0.6rem 0;
  }
  .wordmark-main {
    font-size: 1.0625rem;
    white-space: nowrap;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-10);
  }
  .wordmark-sub {
    margin-top: 0.3rem;
    display: none;
    letter-spacing: 0.08em;
    font-size: 0.625rem;
  }
  @media (min-width: 640px) {
    .wordmark-main { font-size: 1.1875rem; }
  }
  @media (min-width: 900px) {
    .wordmark-sub { display: block; }
  }
  .site-nav {
    display: flex;
    gap: 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.9375rem;
  }
  .site-nav a {
    text-decoration: none;
    color: var(--ink-8);
    padding: 0.25rem 0;
    border-bottom: 1px solid transparent;
    transition: color 150ms cubic-bezier(0.2, 0, 0, 1), border-color 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .site-nav a:hover { color: var(--ink-10); border-bottom-color: var(--ink-4); }
  .site-nav a[aria-current='page'] { color: var(--ink-10); border-bottom-color: var(--series-rule); }
  .site-nav-ext { display: none; }
  @media (min-width: 640px) { .site-nav-ext { display: inline; } .site-nav { gap: 1.25rem; } }

  .theme-set { display: none; gap: 0.25rem; }
  .theme-cycle {
    width: 1.75rem; height: 1.75rem; display: grid; place-items: center;
    background: transparent; border: 0; cursor: pointer; border-radius: 50%;
    box-shadow: 0 0 0 1px var(--series-rule);
  }
  @media (min-width: 640px) {
    .theme-set { display: flex; }
    .theme-cycle { display: none; }
  }
  .theme-swatch {
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: 0;
    cursor: pointer;
    border-radius: 50%;
  }
  .swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
    transition: transform 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .swatch-light { background: #f6f7f8; }
  .swatch-sepia { background: #f3ecdc; }
  .swatch-dark { background: #15161a; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35); }
  .theme-swatch:hover .swatch { transform: scale(1.15); }
  .theme-swatch[aria-pressed='true'] { box-shadow: 0 0 0 1px var(--series-rule); }
</style>

<script>
  const ORDER = ['light', 'sepia', 'dark'];
  function syncThemeButtons() {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((button) => {
      button.setAttribute('aria-pressed', button.dataset.setTheme === current ? 'true' : 'false');
    });
    const swatch = document.getElementById('theme-cycle-swatch');
    if (swatch) swatch.className = `swatch swatch-${current}`;
  }
  document.getElementById('theme-cycle')?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const theme = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
    document.documentElement.setAttribute('data-theme', theme);
    try { localStorage.setItem('mc-theme', theme); } catch { /* ignore */ }
    syncThemeButtons();
    document.dispatchEvent(new CustomEvent('mc:theme', { detail: theme }));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-set-theme]').forEach((button) => {
    button.addEventListener('click', () => {
      const theme = button.dataset.setTheme!;
      document.documentElement.setAttribute('data-theme', theme);
      try { localStorage.setItem('mc-theme', theme); } catch { /* ignore */ }
      syncThemeButtons();
      document.dispatchEvent(new CustomEvent('mc:theme', { detail: theme }));
    });
  });
  document.addEventListener('mc:theme', syncThemeButtons);
  syncThemeButtons();
</script>
