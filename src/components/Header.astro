---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';
interface Props {
  sticky?: boolean;
}

const { sticky = true } = Astro.props;
---

<header class={`${sticky ? 'sticky top-0' : ''} z-50 w-full border-b border-stone-200 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 backdrop-blur supports-[backdrop-filter]:bg-white/60 dark:supports-[backdrop-filter]:bg-slate-950/60 shadow-sm`} transition:persist>
    <div class="container mx-auto flex h-16 items-center px-4">
      <a href="/" class="flex items-center h-full">
        <div class="flex items-center h-full">
          <Image
            src={logoImage}
            alt="Modernized Classics Logo"
            height={36}
            class="w-auto mr-3"
            loading="eager"
            decoding="async"
            format="avif"
          />
          <span class="font-serif font-bold text-stone-900 dark:text-white text-lg">Modernized <span class="text-warm-700 dark:text-warm-400">Classics</span></span>
        </div>
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="ml-auto hidden md:flex items-center gap-6">
        <a href="/" class="nav-link">Home</a>
        <a href="/library" class="nav-link">Library</a>
        <a href="/about" class="nav-link">About</a>
        
        <!-- Dark Mode Toggle -->
        <button 
          type="button"
          id="theme-toggle"
          class="flex items-center justify-center w-9 h-9 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
        >
          <span class="sr-only">Toggle theme</span>
          <!-- Sun icon (shown in dark mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 dark:inline-block hidden">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 dark:hidden inline-block">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
      </nav>
  
      <!-- Mobile menu button -->
      <div class="flex md:hidden items-center gap-2 ml-auto h-full">
        <button 
          type="button"
          id="theme-toggle-mobile"
          class="flex items-center justify-center w-10 h-10 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
        >
          <span class="sr-only">Toggle theme</span>
          <!-- Sun icon (shown in dark mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 dark:inline-block hidden">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 dark:hidden inline-block">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
        
        <button
          type="button"
          id="mobile-menu-toggle"
          class="flex items-center justify-center w-10 h-10 rounded-full text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800"
        >
          <span class="sr-only">Toggle menu</span>
          <!-- Menu icon -->
          <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 inline-block">
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <!-- Close icon -->
          <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 hidden">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  
    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 hidden">
      <div class="py-4 px-4 space-y-1 flex flex-col">
        <a href="/" class="mobile-nav-link">Home</a>
        <a href="/library" class="mobile-nav-link">Library</a>
        <a href="/about" class="mobile-nav-link">About</a>
      </div>
    </div>
  </header>
  
  <style>
    .nav-link {
      @apply text-sm font-medium text-stone-600 dark:text-slate-300 transition-colors hover:text-warm-700 dark:hover:text-warm-400 relative py-2;
      @apply after:absolute after:left-0 after:right-0 after:bottom-0 after:h-0.5 after:bg-warm-600 dark:after:bg-warm-400 after:scale-x-0 after:origin-center after:transition-transform hover:after:scale-x-100;
    }

    .mobile-nav-link {
      @apply py-3 px-3 text-lg w-full text-stone-600 dark:text-slate-300 hover:text-warm-700 dark:hover:text-warm-400 transition-colors font-medium;
    }
  </style>
  
  <script>
    // Dark mode toggle functionality
    function setupThemeToggle() {
      const themeToggles = document.querySelectorAll('#theme-toggle, #theme-toggle-mobile');
      
      // Check for dark mode preference
      const isDarkMode = localStorage.getItem("theme") === "dark" || 
                       (!localStorage.getItem("theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
      
      // Set initial state
      document.documentElement.classList.toggle("dark", isDarkMode);
      
      // Add event listeners
      themeToggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      });
    }
    
    // Mobile menu functionality
    function setupMobileMenu() {
      const menuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      
      if (menuToggle && mobileMenu && menuIcon && closeIcon) {
        menuToggle.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
          menuIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');
        });
      }
    }
    
    // Run setup once DOM is loaded
    document.addEventListener('DOMContentLoaded', () => {
      setupThemeToggle();
      setupMobileMenu();
    });
  </script>