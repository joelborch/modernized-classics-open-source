---
interface Props {
  title: string;
  author: string;
  yearPublished?: number;
  yearModernized?: number;
  description?: string;
  epubLink?: string;
  audioDownload?: string;
  readingTime?: number;
}

const {
  title,
  author,
  yearPublished,
  yearModernized,
  description,
  epubLink,
  audioDownload,
  readingTime
} = Astro.props;
---

<div class="book-header font-sans">
  <div class="book-info">
    <h1 class="book-title font-serif">{title}</h1>
    <p class="book-author">by {author}</p>

    <div class="book-meta">
      {yearPublished && <span>Originally published: {yearPublished}</span>}
      {yearModernized && <span>Modernized: {yearModernized}</span>}
      {readingTime && (
        <span class="reading-time">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          ~{readingTime} min read
        </span>
      )}
    </div>

    {description && (
      <p class="book-description">{description}</p>
    )}
  </div>
  
  <div class="book-actions">
    {epubLink && (
      <a href={epubLink} download class="download-button epub-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="download-icon">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        EPUB
      </a>
    )}
    
    {audioDownload && (
      <a href={audioDownload} target="_blank" rel="noopener noreferrer" class="download-button audio-button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="download-icon">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
        </svg>
        AUDIO
      </a>
    )}
  </div>
</div>

<style>
  .book-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }
  
  @media (min-width: 768px) {
    .book-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  
  .book-title {
    font-family: var(--font-serif), 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
  }

  .book-author {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem 0;
  }

  .book-meta {
    font-size: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: #b45309;
    font-weight: 500;
  }

  .dark .reading-time { color: #fbbf24; }
  [data-theme="sepia"] .reading-time { color: #92400e; }
  
  .book-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 600px;
    margin: 0;
    letter-spacing: var(--letter-spacing);
  }
  
  .book-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  
  @media (min-width: 480px) {
    .book-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
  
  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    font-size: 0.875rem;
  }
  
  .epub-button {
    background-color: #b45309;
    color: white;
  }

  .epub-button:hover {
    background-color: #92400e;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(180, 83, 9, 0.3);
  }
  
  .audio-button {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }
  
  .audio-button:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  
  .download-icon {
    width: 1.25rem;
    height: 1.25rem;
  }
  
  /* Dark mode adjustments */
  .dark .book-title {
    color: var(--color-text);
  }
  
  .dark .book-author,
  .dark .book-years {
    color: var(--color-text-muted);
  }
  
  .dark .book-description {
    color: var(--color-text);
  }
  
  .dark .audio-button {
    background: linear-gradient(135deg, #5b21b6 0%, #581c87 100%);
  }
  
  /* Sepia mode adjustments */
  [data-theme="sepia"] .book-title {
    color: var(--color-text);
  }
  
  [data-theme="sepia"] .book-author,
  [data-theme="sepia"] .book-years {
    color: var(--color-text-muted);
  }
  
  [data-theme="sepia"] .book-description {
    color: var(--color-text);
  }
  
  [data-theme="sepia"] .audio-button {
    background: linear-gradient(135deg, #92400e 0%, #78350f 100%);
  }
</style>