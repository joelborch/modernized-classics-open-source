---
import "../styles/global.css";
import { Font } from 'astro:assets';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import logoIcon from '../assets/logo-favicon.png';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  /** Series colour for this page (an edition page sets its own). */
  series?: string;
  /** Extra class on <body>, e.g. "is-edition" on book pages. */
  bodyClass?: string;
}
const {
  title,
  description = '',
  image,
  canonicalURL,
  series,
  bodyClass = '',
} = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en" style={series ? `--series: ${series}` : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <SEO title={title} description={description} image={image} canonicalURL={canonicalURL} />

  <link rel="icon" href={logoIcon.src} type="image/png" />
  <link rel="apple-touch-icon" href={logoIcon.src} />

  <Font cssVariable="--font-literata" preload />
  <Font cssVariable="--font-atkinson" preload />

  <!-- Theme and reader preferences before first paint. One key each; legacy
       keys from the previous site are read once and migrated. -->
  <script is:inline>
    (() => {
      try {
        const root = document.documentElement;
        const legacyTheme = localStorage.getItem('book-theme') || localStorage.getItem('theme');
        let theme = localStorage.getItem('mc-theme');
        if (!theme && legacyTheme && ['light', 'sepia', 'dark'].includes(legacyTheme)) {
          theme = legacyTheme;
          localStorage.setItem('mc-theme', theme);
        }
        if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.setAttribute('data-theme', theme);

        const size = localStorage.getItem('mc-size') || localStorage.getItem('book-font-size');
        if (size && ['small', 'medium', 'large'].includes(size)) root.setAttribute('data-reader-size', size);
        const leading = localStorage.getItem('mc-leading') || localStorage.getItem('book-line-spacing');
        if (leading && ['compact', 'normal', 'relaxed'].includes(leading)) root.setAttribute('data-reader-leading', leading);
        if (localStorage.getItem('mc-focus') === 'true') root.setAttribute('data-focus', 'true');
      } catch {
        /* storage unavailable: defaults apply */
      }
    })();
  </script>

  <!-- GA-4 in a Partytown worker -->
  <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-EH1GVEYZLH"></script>
  <script type="text/partytown" is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-EH1GVEYZLH');
  </script>
</head>

<body class={bodyClass}>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  /* Focus mode: the reader asked for the text alone. The running head stays. */
  :root[data-focus='true'] .site-header,
  :root[data-focus='true'] .site-footer {
    display: none;
  }
</style>
