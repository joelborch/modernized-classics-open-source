---
/**
 * The reading edition. One long page: a running head that always says where
 * you are, the edition band (cover as object, provenance, downloads), the
 * text at a book measure, and an outer rail carrying chapter ticks, progress,
 * and the ribbon marking where you stopped last time.
 */
import type { ImageMetadata } from 'astro';
import Cover from '../components/Cover.astro';
import type { Chapter } from '../lib/edition';

interface Props {
  slug: string;
  title: string;
  author: string;
  yearLabel?: string;
  yearModernized?: number;
  description?: string;
  epubHref: string;
  audioHref?: string;
  readingTime: string;
  readingMinutes: number;
  words: string;
  chapters: Chapter[];
  chapterDepth: number;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const {
  slug, title, author, yearLabel, yearModernized, description,
  epubHref, audioHref, readingTime, readingMinutes, words,
  chapters, chapterDepth, cover, coverAlt,
} = Astro.props;

const chaptersJson = JSON.stringify(chapters.map((c) => ({ slug: c.slug, text: c.text, index: c.index })));
---

<div
  class="edition"
  id="edition"
  data-slug={slug}
  data-title={title}
  data-chapter-depth={chapterDepth}
  data-reading-minutes={readingMinutes}
>
  <!-- Running head -->
  <div class="running-head" id="running-head">
    <div class="wrap rh-row">
      <span class="rh-author t-label">{author}</span>
      <button type="button" class="rh-title t-text" id="rh-title" aria-haspopup="dialog" aria-controls="contents-dialog" title="Contents">
        <em class="rh-work">{title}</em>
        <span class="rh-chapter" id="rh-chapter" aria-live="polite"></span>
      </button>
      <div class="rh-tools">
        <span class="rh-pct t-meta" id="rh-pct" aria-label="Progress through the text">0%</span>
        <button type="button" class="icon-button" id="contents-button" aria-haspopup="dialog" aria-controls="contents-dialog" aria-label="Contents" title="Contents">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h9" />
          </svg>
        </button>
        <button type="button" class="icon-button rh-aa t-text" id="menu-button" aria-expanded="false" aria-controls="reader-menu" aria-label="Reading settings" title="Reading settings">
          <span aria-hidden="true">Aa</span>
        </button>
      </div>
    </div>

    <!-- Reading settings -->
    <div class="reader-menu" id="reader-menu" hidden>
      <div class="menu-section">
        <span class="t-label">Size</span>
        <div class="segmented" role="group" aria-label="Text size">
          <button type="button" data-size="small" class="t-text" style="font-size:0.875rem" aria-label="Small">A</button>
          <button type="button" data-size="medium" class="t-text" style="font-size:1.0625rem" aria-label="Medium">A</button>
          <button type="button" data-size="large" class="t-text" style="font-size:1.3125rem" aria-label="Large">A</button>
        </div>
      </div>
      <div class="menu-section">
        <span class="t-label">Spacing</span>
        <div class="segmented" role="group" aria-label="Line spacing">
          <button type="button" data-leading="compact" aria-label="Compact"><span class="lines lines-1"></span></button>
          <button type="button" data-leading="normal" aria-label="Normal"><span class="lines lines-2"></span></button>
          <button type="button" data-leading="relaxed" aria-label="Relaxed"><span class="lines lines-3"></span></button>
        </div>
      </div>
      <div class="menu-section">
        <span class="t-label">Paper</span>
        <div class="segmented" role="group" aria-label="Theme">
          <button type="button" data-set-theme="light" aria-label="Light"><span class="swatch" style="background:#f6f7f8"></span>Light</button>
          <button type="button" data-set-theme="sepia" aria-label="Sepia"><span class="swatch" style="background:#f3ecdc"></span>Sepia</button>
          <button type="button" data-set-theme="dark" aria-label="Dark"><span class="swatch" style="background:#15161a"></span>Dark</button>
        </div>
      </div>
      <label class="menu-toggle">
        <input type="checkbox" id="focus-toggle" />
        <span>Text only: hide the site header and footer</span>
      </label>
    </div>
  </div>

  <!-- Edition band -->
  <header class="wrap edition-band">
    <div class="band-cover">
      <Cover src={cover} alt={coverAlt || `Cover of ${title}`} title={title} author={author} width={240} loading="eager" sizes="(min-width: 768px) 240px, 168px" />
    </div>
    <div class="band-info">
      <h1 class="band-title t-display">{title}</h1>
      <p class="band-author t-text">{author}</p>
      <p class="band-provenance t-meta">
        {yearLabel && <span>Originally {yearLabel}</span>}
        {yearModernized && <span>Modernized {yearModernized}</span>}
        <span>{readingTime}</span>
        <span>{words}</span>
      </p>
      {description && <p class="band-description t-text">{description}</p>}

      <div class="band-actions">
        <a href="#text-start" class="action action-primary" id="start-reading">Start reading</a>
        <a href="#text-start" class="action action-primary" id="resume-reading" hidden>
          Resume<span class="resume-where" id="resume-where"></span>
        </a>
        <a href={epubHref} download class="band-download">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3v10m0 0l-4-4m4 4l4-4M4 16h12" /></svg>
          EPUB
        </a>
        {audioHref && (
          <a href={audioHref} target="_blank" rel="noopener noreferrer" class="band-download">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8v4h3l4 3V5L7 8H4zM14 7a4 4 0 010 6M16 5a7 7 0 010 10" /></svg>
            Audio, MP3
          </a>
        )}
      </div>

      {chapters.length > 0 && (
        <details class="contents">
          <summary class="contents-summary">
            <span class="t-label">Contents</span>
            <span class="t-meta contents-count">{chapters.length} {chapters.length === 1 ? 'section' : 'sections'}
              <svg class="disclosure" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 8l5 5 5-5" /></svg>
            </span>
          </summary>
          <ol class="contents-list t-text">
            {chapters.map((chapter) => (
              <li>
                <a href={`#${chapter.slug}`}>
                  <span class="contents-n t-meta">{chapter.index}</span>
                  <span>{chapter.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </div>
  </header>

  <!-- Text and rail -->
  <div class="wrap edition-body">
    <span id="text-start" class="text-start" aria-hidden="true"></span>
    <article class="edition-text t-text" id="edition-text">
      <slot />
      <p class="text-end t-meta">End of <em>{title}</em>. <a href="/library/">Choose another edition</a>.</p>
    </article>

    <nav class="rail" id="rail" aria-label="Chapters">
      <div class="rail-track">
        <div class="rail-progress" id="rail-progress"></div>
        <div class="rail-ribbon" id="rail-ribbon" hidden title="Where you stopped last time"></div>
        {chapters.map((chapter) => (
          <a
            href={`#${chapter.slug}`}
            class="tick"
            data-chapter={chapter.index}
            data-target={chapter.slug}
            aria-label={`${chapter.index}. ${chapter.text}`}
            data-title={chapter.text}
          ></a>
        ))}
      </div>
    </nav>
  </div>

  <!-- Contents dialog -->
  <dialog class="contents-dialog" id="contents-dialog" aria-labelledby="contents-dialog-title">
    <div class="dialog-head">
      <span id="contents-dialog-title" class="t-label">Contents · <em class="t-text">{title}</em></span>
      <button type="button" class="icon-button" id="contents-close" aria-label="Close">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
      </button>
    </div>
    <ol class="dialog-list t-text">
      {chapters.map((chapter) => (
        <li>
          <a href={`#${chapter.slug}`} data-target={chapter.slug}>
            <span class="contents-n t-meta">{chapter.index}</span>
            <span>{chapter.text}</span>
          </a>
        </li>
      ))}
    </ol>
  </dialog>

  <script is:inline type="application/json" id="chapters-data" set:html={chaptersJson}></script>
</div>

<script>
  import '../scripts/reader';
</script>

<style>
  /* ---------- Running head ---------- */
  .running-head {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--series-rule);
  }
  .rh-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    height: var(--running-head-h);
  }
  @media (min-width: 900px) {
    .rh-row { grid-template-columns: 1fr minmax(0, 2fr) 1fr; }
  }
  .rh-author { display: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (min-width: 900px) { .rh-author { display: block; } }
  .rh-title {
    background: none;
    border: 0;
    padding: 0;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    justify-self: start;
    font-size: 1rem;
    color: var(--ink-10);
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
  }
  @media (min-width: 900px) { .rh-title { justify-self: center; } }
  .rh-work { font-style: italic; flex-shrink: 0; }
  .rh-chapter {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    color: var(--ink-7);
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .rh-chapter:not(:empty)::before { content: '· '; }
  .rh-tools { display: flex; align-items: center; gap: 0.125rem; justify-self: end; }
  .rh-pct { min-width: 2.75rem; text-align: right; margin-right: 0.25rem; }
  .rh-aa { font-size: 0.9375rem; letter-spacing: -0.02em; }

  /* ---------- Reader menu ---------- */
  .reader-menu {
    position: absolute;
    right: max(1.25rem, calc((100% - 78rem) / 2));
    top: calc(var(--running-head-h) + 0.5rem);
    width: min(20rem, calc(100vw - 2.5rem));
    background: var(--paper);
    border: 1px solid var(--ink-5);
    padding: 1rem;
    display: grid;
    gap: 1rem;
    font-family: var(--font-ui);
  }
  .reader-menu[hidden] { display: none; }
  .menu-section { display: grid; gap: 0.4rem; }
  .segmented { display: flex; border: var(--rule); }
  .segmented > button {
    flex: 1;
    min-height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: transparent;
    border: 0;
    border-right: var(--rule);
    border-bottom: 2px solid transparent;
    color: var(--ink-8);
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .segmented > button:last-child { border-right: 0; }
  .segmented > button:hover { background: var(--ink-1); color: var(--ink-10); }
  .segmented > button[aria-pressed='true'] { background: var(--series-tint); color: var(--ink-10); border-bottom-color: var(--series-rule); }
  .swatch { width: 0.75rem; height: 0.75rem; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.3); }
  .lines { display: inline-block; width: 1rem; height: 0.875rem; background: repeating-linear-gradient(to bottom, currentColor 0 1.5px, transparent 1.5px var(--gap)); }
  .lines-1 { --gap: 4px; }
  .lines-2 { --gap: 5.5px; }
  .lines-3 { --gap: 7px; }
  .menu-toggle { display: flex; gap: 0.6rem; align-items: center; font-size: 0.8125rem; color: var(--ink-8); cursor: pointer; }
  .menu-toggle input { accent-color: var(--series); width: 1rem; height: 1rem; }

  /* ---------- Edition band ---------- */
  .edition-band {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    padding: 2.5rem 0 2rem;
    border-bottom: var(--rule);
  }
  @media (min-width: 768px) {
    .edition-band {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 3rem;
      padding: 3.5rem 0 2.5rem;
    }
  }
  .band-cover { width: 168px; }
  @media (min-width: 768px) { .band-cover { width: 240px; position: sticky; top: calc(var(--running-head-h) + 1.5rem); align-self: start; } }
  .band-info { max-width: 62ch; }
  .band-title { font-size: clamp(2.25rem, 4.5vw + 0.5rem, 3.5rem); margin: 0 0 0.5rem; color: var(--ink-10); }
  .band-author { font-size: 1.25rem; margin: 0 0 0.75rem; color: var(--ink-9); }
  .band-provenance { display: flex; flex-wrap: wrap; gap: 0 0.5rem; margin: 0 0 1.25rem; }
  .band-provenance span { white-space: nowrap; }
  .band-provenance span:not(:last-child)::after { content: '·'; margin-left: 0.5rem; color: var(--ink-5); }
  .band-description { font-size: 1.0625rem; line-height: 1.55; color: var(--ink-9); margin: 0 0 1.5rem; }
  .band-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
  .band-actions [hidden] { display: none; }
  .resume-where { margin-left: 0.35rem; font-weight: 400; opacity: 0.9; }
  .resume-where:not(:empty)::before { content: 'at '; }
  .band-download {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-ui); font-size: 0.9375rem; color: var(--ink-9);
    text-decoration-color: var(--ink-4);
  }
  .band-download svg { width: 1rem; height: 1rem; color: var(--ink-7); }

  .contents { margin-top: 2rem; border-top: var(--rule); }
  .contents-summary {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 0.75rem 0; cursor: pointer; list-style: none;
  }
  .contents-summary::-webkit-details-marker { display: none; }
  .contents-count { display: inline-flex; align-items: center; gap: 0.5rem; }
  .disclosure { width: 1rem; height: 1rem; color: var(--ink-6); transition: transform 150ms cubic-bezier(0.2, 0, 0, 1); }
  .contents[open] .disclosure { transform: rotate(180deg); }
  .contents-list {
    margin: 0 0 0.5rem; padding: 0; list-style: none;
    columns: 1; column-gap: 2.5rem;
    font-size: 0.9375rem; line-height: 1.4;
  }
  @media (min-width: 640px) { .contents-list { columns: 2; } }
  .contents-list li { break-inside: avoid; padding: 0.3rem 0; border-bottom: 1px solid var(--ink-2); }
  .contents-list a, .dialog-list a { display: flex; gap: 0.75rem; text-decoration: none; color: var(--ink-9); }
  .contents-list a:hover, .dialog-list a:hover { color: var(--series-ink); }
  .contents-n { min-width: 1.75rem; text-align: right; color: var(--ink-6); }

  /* ---------- Body: text + rail ---------- */
  .edition-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: 2.5rem;
    position: relative;
  }
  @media (min-width: 768px) {
    .edition-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--measure)) minmax(4.5rem, 1fr);
      column-gap: 2rem;
    }
    .edition-text { grid-column: 2; }
    .rail { grid-column: 3; }
  }
  .text-start { display: block; position: relative; top: calc(-1 * var(--running-head-h) - 1rem); }
  .text-end { margin-top: 4rem; padding-top: 1rem; border-top: var(--rule); font-family: var(--font-ui); }

  /* ---------- Rail ---------- */
  .rail {
    position: sticky;
    top: calc(var(--running-head-h) + 2.5rem);
    align-self: start;
    height: calc(100dvh - var(--running-head-h) - 5rem);
    display: none;
  }
  @media (min-width: 768px) { .rail { display: block; } }
  .rail-track {
    position: relative;
    height: 100%;
    width: 1px;
    background: var(--ink-3);
    margin-left: 1rem;
  }
  .rail-progress {
    position: absolute; top: 0; left: 0; width: 1px; height: 100%;
    background: var(--series-rule);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 120ms linear;
  }
  .tick {
    position: absolute;
    left: -3px;
    top: var(--y, 0%);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--ink-4);
    transform: translateY(-50%);
    transition: border-color 150ms cubic-bezier(0.2, 0, 0, 1), background-color 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tick:hover, .tick:focus-visible { border-color: var(--series-rule); }
  .tick.is-past { background: var(--series-rule); border-color: var(--series-rule); }
  .tick.is-current { background: var(--paper); border: 2px solid var(--series-rule); width: 11px; height: 11px; left: -5px; z-index: 1; }
  .tick::after {
    content: attr(data-chapter) '. ' attr(data-title);
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: var(--ink-7);
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tick:hover::after, .tick:focus-visible::after, .tick.is-current::after { opacity: 1; }
  .tick.is-current::after { color: var(--ink-10); }
  @media (min-width: 768px) and (max-width: 1099px) {
    .tick.is-current::after { display: none; }
  }
  .rail-ribbon {
    position: absolute;
    left: -6px;
    top: var(--y, 0%);
    width: 13px;
    height: 34px;
    background: var(--series-rule);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
    transform-origin: top center;
    z-index: 2;
  }
  .rail-ribbon[hidden] { display: none; }
  .rail-ribbon.is-settling { animation: ribbon-settle 700ms cubic-bezier(0.2, 0, 0, 1) both; }
  @keyframes ribbon-settle {
    from { transform: translateY(-14px) scaleY(0.6); opacity: 0; }
    to { transform: translateY(0) scaleY(1); opacity: 1; }
  }

  /* Mobile edge rail: the same axis, three pixels wide, on the right edge. */
  .edge-rail {
    position: fixed;
    top: var(--running-head-h);
    right: 0;
    bottom: 0;
    width: 3px;
    background: var(--ink-2);
    z-index: 30;
  }
  .edge-rail-progress { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: var(--series-rule); transform: scaleY(0); transform-origin: top; }
  .edge-rail-ribbon { position: absolute; right: 0; width: 8px; height: 22px; background: var(--series-rule); clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 75%, 0 100%); transform: translateY(-50%); }
  @media (min-width: 768px) { .edge-rail { display: none; } }

  /* ---------- Contents dialog ---------- */
  .contents-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(80dvh, 44rem);
    padding: 0;
    border: var(--rule);
    background: var(--paper);
    color: var(--ink-10);
  }
  .contents-dialog::backdrop { background: rgba(20, 20, 15, 0.35); backdrop-filter: blur(2px); }
  :root[data-theme='dark'] .contents-dialog::backdrop { background: rgba(0, 0, 0, 0.6); }
  .dialog-head {
    position: sticky; top: 0;
    display: flex; justify-content: space-between; align-items: center;
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
    background: var(--paper);
    border-bottom: var(--rule);
  }
  .dialog-head em { text-transform: none; letter-spacing: 0; font-size: 0.9375rem; color: var(--ink-10); }
  .dialog-list { list-style: none; margin: 0; padding: 0.5rem 1.25rem 1rem; font-size: 0.9375rem; line-height: 1.4; }
  .dialog-list li { padding: 0.4rem 0; border-bottom: 1px solid var(--ink-2); }
  .dialog-list a.is-current { color: var(--series-ink); }
</style>

<style is:global>
  /* ---------- The text ---------- */
  .edition-text {
    max-width: var(--measure);
    font-size: var(--reader-size);
    line-height: var(--reader-leading);
    color: var(--ink-10);
    font-variation-settings: 'opsz' 14;
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .edition-text p { margin: 0 0 0.9em; }
  .edition-text > p:first-of-type,
  .edition-text h2 + p,
  .edition-text h3 + p { margin-top: 0; }

  .edition-text h2,
  .edition-text h3,
  .edition-text h4 {
    font-weight: 500;
    color: var(--ink-10);
    scroll-margin-top: calc(var(--running-head-h) + 1.5rem);
    text-wrap: balance;
  }
  .edition-text h2 {
    font-size: 1.75em;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 3.25em 0 0.75em;
    font-variation-settings: 'opsz' 40;
  }
  .edition-text h3 {
    font-size: 1.25em;
    line-height: 1.25;
    margin: 2.25em 0 0.6em;
    font-variation-settings: 'opsz' 24;
  }
  .edition-text h4 { font-size: 1.05em; margin: 1.75em 0 0.5em; font-weight: 600; }
  .edition-text > :is(h2, h3):first-child { margin-top: 0.25em; }

  .edition-text [data-half-title] {
    margin-top: 0;
    font-size: 1.125em;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-7);
  }

  .edition-text strong { font-weight: 600; }
  .edition-text em { font-style: italic; }
  .edition-text a { text-decoration-color: var(--series-ink); }
  .edition-text ul, .edition-text ol { margin: 0 0 1em; padding-left: 1.5em; }
  .edition-text li { margin: 0.3em 0; }
  .edition-text li::marker { color: var(--ink-6); }
  .edition-text blockquote {
    margin: 1.25em 0;
    padding-left: 1.25em;
    border-left: 1px solid var(--ink-4);
    color: var(--ink-9);
  }
