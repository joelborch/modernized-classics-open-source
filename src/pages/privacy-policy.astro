---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy";
const description = "Learn how Modernized Classics protects your privacy. We collect minimal data, use secure practices, and respect your rights.";
---

<BaseLayout {title} {description}>
  <main class="container mx-auto px-6 py-10">
    <article class="prose dark:prose-invert max-w-none">
      <h1>Privacy Policy</h1>
      <p><em>Last updated – April 21, 2025</em></p>

      <h2>1. Information We Collect</h2>
      <ul>
        <li><strong>Basic analytics</strong>—page views and referrer data via Cloudflare Web Analytics.</li>
        <li><strong>Newsletter sign‑ups</strong>—your email address only when you voluntarily subscribe.</li>
        <li><strong>Theme preference cookie</strong>—a first‑party cookie that remembers your light/dark/sepia selection.</li>
      </ul>

      <h2>2. How We Use Information</h2>
      <p>
        Analytics help us decide which books to modernize next; email addresses are used
        solely for sending newsletter updates you requested.
      </p>

      <h2>3. Cookies</h2>
      <p>
        We use only first‑party cookies; you can disable cookies in your browser without
        losing access to the Site.
      </p>

      <h2>4. Data Sharing</h2>
      <p>
        We do not sell or rent personal data. Aggregated, anonymized statistics may be
        published publicly.
      </p>

      <h2>5. Data Retention</h2>
      <p>
        Analytics logs are retained for 12 months, then deleted. Newsletter data is kept
        until you unsubscribe.
      </p>

      <h2>6. Children's Privacy</h2>
      <p>
        The Site is not directed to children under 13, and we do not knowingly collect
        personal information from children.
      </p>

      <h2>7. Your Rights</h2>
      <p>
        Depending on your jurisdiction, you may request access, correction, or deletion of
        your personal data via the contact form at <code>/contact</code>.
      </p>

      <h2>8. Security</h2>
      <p>
        We use HTTPS, Cloudflare DDoS protection, and least‑privilege access controls to
        safeguard data. No method of transmission is 100 % secure.
      </p>

      <h2>9. Changes to This Policy</h2>
      <p>
        We may revise this Privacy Policy from time to time. A revised date will appear at
        the top of this page, and significant changes will be announced on the homepage.
      </p>

      <h2>10. Contact</h2>
      <p>
        For privacy inquiries, please use the contact form at <code>/contact</code>.
      </p>
    </article>
  </main>
</BaseLayout>
