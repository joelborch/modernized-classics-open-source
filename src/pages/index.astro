---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Cover from "../components/Cover.astro";
import {
  displayAuthor, readingTime, seriesColor, shelves, sortByTitle, startHere, wordCount, yearLabel,
} from "../lib/edition";

const books = sortByTitle(await getCollection("books"));
const bySlug = new Map(books.map((b) => [b.id, b]));

const picks = startHere
  .map((p) => ({ ...p, book: bySlug.get(p.slug) }))
  .filter((p) => p.book) as { slug: string; line: string; book: (typeof books)[number] }[];

const shelved = new Set(shelves.flatMap((s) => s.slugs));
const rows = shelves
  .map((s) => ({ ...s, books: s.slugs.map((id) => bySlug.get(id)).filter(Boolean) as typeof books }))
  .filter((s) => s.books.length > 0);
const rest = books.filter((b) => !shelved.has(b.id));
if (rest.length) rows.push({ id: 'further', title: 'Further reading', note: 'Recent additions, not yet shelved.', slugs: rest.map((b) => b.id), books: rest });

const totalWords = books.reduce((n, b) => n + wordCount(b.body), 0);

const title = "Modernized Classics";
const description = "Public-domain classics of philosophy, politics, economics, and science, rewritten sentence by sentence into clear modern English. Free to read online or download as EPUB.";
const canonicalURL = new URL('/', Astro.site).toString();
---

<BaseLayout {title} {description} {canonicalURL}>
  <!-- Masthead statement -->
  <section class="wrap masthead">
    <h1 class="t-display masthead-title">
      The classics, in the English you already speak.
    </h1>
    <div class="masthead-side">
      <p class="t-text masthead-lede">
        Twenty-eight public-domain works of philosophy, politics, economics, and science, each rewritten
        sentence by sentence into clear modern prose. Nothing is summarized or cut. Read them here, or take
        the EPUB with you. Free, without an account.
      </p>
      <p class="t-meta masthead-facts">
        <span>{books.length} editions</span>
        <span>{Math.round(totalWords / 1000).toLocaleString('en')},000 words</span>
        <span>Open source</span>
      </p>
      <p class="masthead-actions">
        <a href="/library/" class="action action-primary">Browse the library</a>
        <a href="/about/" class="masthead-link">How an edition is made</a>
      </p>
    </div>
  </section>

  <!-- Start here -->
  <section class="wrap start-here" aria-labelledby="start-here-title">
    <div class="section-head">
      <h2 id="start-here-title" class="t-text section-title">Start here</h2>
      <p class="t-meta">Three short, complete works that repay a first evening.</p>
    </div>
    <ol class="picks">
      {picks.map(({ book, line }) => {
        const words = wordCount(book.body);
        return (
          <li class="pick" style={`--series: ${seriesColor(book.id) ?? 'var(--ink-8)'}`}>
            <a href={`/books/${book.id}/`} class="cover-link pick-cover">
              <Cover src={book.data.coverImage} alt={book.data.coverAlt || `Cover of ${book.data.title}`} title={book.data.title} author={displayAuthor(book.data.author)} width={220} sizes="(min-width: 768px) 220px, 40vw" loading="eager" />
            </a>
            <div class="pick-info">
              <h3 class="t-text pick-title"><a href={`/books/${book.id}/`} class="link-quiet">{book.data.title}</a></h3>
              <p class="t-meta pick-meta">
                <span>{displayAuthor(book.data.author)}</span>
                {book.data.yearPublished && <span>{yearLabel(book.data.yearPublished)}</span>}
                <span>{readingTime(words)}</span>
              </p>
              <p class="t-text pick-line">{line}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- The shelf -->
  <section class="wrap shelf" aria-labelledby="shelf-title">
    <div class="section-head">
      <h2 id="shelf-title" class="t-text section-title">The shelf</h2>
      <p class="t-meta">Every edition, grouped by the question it answers. <a href="/library/">Search and filter the library</a> for the full list.</p>
    </div>
    {rows.map((row) => (
      <div class="shelf-row">
        <div class="shelf-label">
          <h3 class="t-text shelf-title">{row.title}</h3>
          <p class="t-meta shelf-note">{row.note}</p>
        </div>
        <ul class="shelf-books">
          {row.books.map((book) => (
            <li style={`--series: ${seriesColor(book.id) ?? 'var(--ink-8)'}`}>
              <a href={`/books/${book.id}/`} class="cover-link shelf-book">
                <Cover src={book.data.coverImage} alt={book.data.coverAlt || `Cover of ${book.data.title}`} title={book.data.title} author={displayAuthor(book.data.author)} width={150} sizes="(min-width: 1024px) 150px, (min-width: 640px) 22vw, 42vw" />
                <span class="shelf-book-title t-text">{book.data.title}</span>
                <span class="shelf-book-author t-meta">{displayAuthor(book.data.author)}{book.data.yearPublished ? `, ${yearLabel(book.data.yearPublished)}` : ''}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <!-- Method, briefly -->
  <section class="wrap method" aria-labelledby="method-title">
    <h2 id="method-title" class="t-text section-title">A note on the text</h2>
    <div class="method-cols t-text">
      <p>
        Each edition starts from a public-domain source. A pipeline cuts the work into passages, rewrites
        every passage into modern English with a language model, and then checks each rewrite against its
        source for dropped content, changed meaning, summarizing, and stray commentary. Passages that fail
        are revised and checked again; those that still fail are never published.
      </p>
      <p>
        The result is a complete modern reading of the whole work, not an abridgement. It is also machine
        prose reviewed by a machine, so treat it as a way in, and quote the original when it matters.
        The pipeline, prompts, and site are <a href="https://github.com/joelborch/modernized-classics-open-source" rel="noopener">open source</a>;
        the <a href="/about/">colophon</a> explains the method in full.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .masthead {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3.5rem 0 3rem;
    border-bottom: var(--rule);
  }
  @media (min-width: 900px) {
    .masthead { grid-template-columns: 7fr 5fr; gap: 4rem; padding: 5rem 0 4rem; align-items: end; }
  }
  .masthead-title {
    font-size: clamp(2.5rem, 6vw + 0.5rem, 5.5rem);
    margin: 0;
    max-width: 14ch;
  }
  .masthead-lede { font-size: 1.125rem; line-height: 1.55; margin: 0 0 1.25rem; color: var(--ink-9); max-width: 46ch; }
  .masthead-facts { display: flex; flex-wrap: wrap; gap: 0 0.5rem; margin: 0 0 1.5rem; }
  .masthead-facts span + span::before { content: '·'; margin-right: 0.5rem; color: var(--ink-5); }
  .masthead-actions { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; margin: 0; }
  .masthead-link { font-family: var(--font-ui); font-size: 0.9375rem; color: var(--ink-9); }

  .section-head { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1.75rem; }
  .section-title { font-size: 1.5rem; font-weight: 500; margin: 0; letter-spacing: -0.01em; }

  .start-here { padding: 3.5rem 0 1rem; }
  .picks {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 768px) { .picks { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .pick { display: grid; grid-template-columns: 120px 1fr; gap: 1.25rem; align-items: start; }
  @media (min-width: 768px) { .pick { grid-template-columns: 1fr; gap: 1rem; } .pick-cover { width: 220px; max-width: 100%; } }
  .pick-title { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.25rem; }
  .pick-title a { text-decoration: none; }
  .pick-title a:hover { text-decoration: underline; text-decoration-color: var(--series-ink); }
  .pick-meta { display: flex; flex-wrap: wrap; gap: 0 0.5rem; margin: 0 0 0.5rem; }
  .pick-meta span + span::before { content: '·'; margin-right: 0.5rem; color: var(--ink-5); }
  .pick-line { font-size: 1rem; line-height: 1.5; color: var(--ink-9); margin: 0; max-width: 34ch; }

  .shelf { padding: 3.5rem 0 1rem; }
  .shelf-row {
    display: grid; grid-template-columns: 1fr; gap: 1rem;
    padding: 1.75rem 0; border-top: var(--rule);
  }
  @media (min-width: 900px) { .shelf-row { grid-template-columns: 16rem minmax(0, 1fr); gap: 2.5rem; padding: 2.25rem 0; } }
  .shelf-title { font-size: 1.125rem; font-weight: 500; margin: 0 0 0.25rem; }
  .shelf-note { margin: 0; max-width: 24ch; }
  .shelf-books {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1.25rem;
  }
  @media (min-width: 640px) { .shelf-books { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .shelf-books { grid-template-columns: repeat(auto-fill, minmax(140px, 150px)); gap: 2rem 1.5rem; } }
  .shelf-book { display: grid; gap: 0.5rem; }
  .shelf-book-title { font-size: 0.9375rem; line-height: 1.25; font-weight: 500; margin-top: 0.35rem; }
  .shelf-book-author { font-size: 0.75rem; line-height: 1.3; }

  .method { padding: 3.5rem 0 1rem; border-top: var(--rule); margin-top: 2rem; }
  .method .section-title { margin-bottom: 1.25rem; }
  .method-cols { display: grid; grid-template-columns: 1fr; gap: 0 3rem; font-size: 1.0625rem; line-height: 1.6; color: var(--ink-9); }
  @media (min-width: 900px) { .method-cols { grid-template-columns: 1fr 1fr; } }
  .method-cols p { margin: 0 0 1em; max-width: 52ch; }
  .method-cols a { text-decoration-color: var(--series-ink); }
</style>
