---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/library.css';
import LibraryClient from '../components/LibraryClient';
import type { LibraryBook } from '../components/LibraryClient';
import { displayAuthor, readingMinutes, readingTime, seriesColor, shelves, sortByTitle, wordCount, yearLabel } from '../lib/edition';

const books = sortByTitle(await getCollection('books'));
const shelfOf = new Map<string, string>();
shelves.forEach((s) => s.slugs.forEach((slug) => shelfOf.set(slug, s.id)));

const items: LibraryBook[] = await Promise.all(
  books.map(async (book) => {
    let cover: LibraryBook['cover'];
    if (book.data.coverImage) {
      const optimized = await getImage({ src: book.data.coverImage, widths: [160, 240, 320, 480], format: 'webp', quality: 82 });
      cover = {
        src: optimized.src,
        srcSet: (optimized.attributes as { srcset?: string }).srcset ?? '',
        width: Number(optimized.attributes.width),
        height: Number(optimized.attributes.height),
      };
    }
    const words = wordCount(book.body);
    return {
      slug: book.id,
      title: book.data.title,
      author: displayAuthor(book.data.author),
      description: book.data.description ?? '',
      tags: book.data.tags ?? [],
      year: book.data.yearPublished,
      yearLabel: yearLabel(book.data.yearPublished),
      minutes: readingMinutes(words),
      length: readingTime(words),
      audio: !!book.data.audioDownload,
      epub: book.data.downloads?.epub || `/downloads/${book.id}.epub`,
      shelf: shelfOf.get(book.id) ?? 'further',
      series: seriesColor(book.id),
      cover,
      coverAlt: book.data.coverAlt,
    };
  }),
);

const shelfOptions = shelves.map((s) => ({ id: s.id, title: s.title }));
if (items.some((i) => i.shelf === 'further')) shelfOptions.push({ id: 'further', title: 'Further reading' });

const title = 'Library';
const description = `All ${books.length} Modernized Classics editions: search by title or author, filter by subject or format, and read online or download the EPUB.`;
---

<BaseLayout {title} {description}>
  <section class="wrap library-head">
    <h1 class="t-display library-title">Library</h1>
    <p class="t-meta">{books.length} editions · every one free to read here or download as EPUB</p>
  </section>
  <section class="wrap">
    <LibraryClient books={items} shelves={shelfOptions} client:load />
  </section>
</BaseLayout>

<style>
  .library-head { padding: 3rem 0 1.5rem; }
  .library-title { font-size: clamp(2.5rem, 5vw, 4rem); margin: 0 0 0.5rem; }
</style>
