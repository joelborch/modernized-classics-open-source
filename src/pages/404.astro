---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page Not Found";
const description = "The page you requested could not be found.";
---

<BaseLayout {title} {description}>
  <main class="container mx-auto px-6 py-24 text-center">
    <h1 class="text-4xl font-bold mb-4">404 - Page Not Found</h1>
    <p class="mb-6">Sorry, we couldn't find the page you're looking for.</p>
    <a href="/" class="text-blue-600 dark:text-blue-400 underline">Return to Home</a>
  </main>
</BaseLayout>
