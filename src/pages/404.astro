---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found";
const description = "There is no page at this address.";
---

<BaseLayout {title} {description}>
  <section class="wrap folio">
    <p class="t-label">404</p>
    <h1 class="t-display folio-title">This page is blank.</h1>
    <p class="t-text folio-note">
      Nothing is printed at this address. The work you wanted may have moved when we corrected a
      title, so the library is the surest way back.
    </p>
    <p class="folio-actions">
      <a href="/library/" class="action action-primary">Open the library</a>
      <a href="/" class="folio-link">Front page</a>
    </p>
  </section>
</BaseLayout>

<style>
  .folio { padding: 6rem 0 4rem; max-width: 40rem; }
  .folio-title { font-size: clamp(2.5rem, 6vw, 4.5rem); margin: 0.5rem 0 1.25rem; }
  .folio-note { font-size: 1.125rem; line-height: 1.55; color: var(--ink-9); margin: 0 0 2rem; max-width: 44ch; }
  .folio-actions { display: flex; gap: 1.25rem; align-items: center; margin: 0; }
  .folio-link { font-family: var(--font-ui); font-size: 0.9375rem; }
</style>
