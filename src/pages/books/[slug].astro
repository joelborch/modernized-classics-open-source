---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookLayout from '../../layouts/BookLayout.astro';
import {
  chaptersFrom, displayAuthor, formatWords, readingMinutes, readingTime,
  seriesColor, wordCount, yearLabel,
} from '../../lib/edition';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const data = book.data;
const { Content, headings } = await render(book);

const author = displayAuthor(data.author);
const chapters = chaptersFrom(headings, data.title);
const chapterDepth = chapters[0]?.depth ?? 2;
const words = wordCount(book.body);

const title = `${data.title} by ${author}`;
const description = data.description || `Read ${data.title} by ${author}, a public-domain classic rewritten into clear modern English. Free to read online or download as an EPUB.`;
const canonicalURL = new URL(`/books/${book.id}/`, Astro.site).toString();
const image = data.coverImage ? new URL(data.coverImage.src, Astro.site).toString() : undefined;
---

<BaseLayout {title} {description} {canonicalURL} image={image} series={seriesColor(book.id)} bodyClass="is-edition">
  <BookLayout
    slug={book.id}
    title={data.title}
    author={author}
    yearLabel={yearLabel(data.yearPublished)}
    yearModernized={data.yearModernized}
    description={data.description}
    epubHref={data.downloads?.epub || `/downloads/${book.id}.epub`}
    audioHref={data.audioDownload}
    readingTime={readingTime(words)}
    readingMinutes={readingMinutes(words)}
    words={formatWords(words)}
    chapters={chapters}
    chapterDepth={chapterDepth}
    cover={data.coverImage}
    coverAlt={data.coverAlt}
  >
    <Content />
  </BookLayout>
</BaseLayout>
