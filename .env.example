# Set these in your shell; the pipeline does not load .env automatically.
# Authenticate each CLI locally. Never commit credentials.
# MODERNIZE_PROVIDER=claude
# MODERNIZE_MODEL=opus
# MODERNIZE_CLI=/absolute/path/to/cli
# MODERNIZE_TIMEOUT_MS=300000
# MODERNIZE_CHUNK_CHARS=24000
# Custom provider only: JSON argument array, no shell interpolation.
# MODERNIZE_CLI_ARGS=["/absolute/path/to/wrapper.mjs"]
# MODERNIZE_EFFORT_REWRITE=high
# MODERNIZE_EFFORT_QA=medium

# Gemini through AGY: MODERNIZE_PROVIDER=agy MODERNIZE_MODEL=gemini-3.7-flash-low
